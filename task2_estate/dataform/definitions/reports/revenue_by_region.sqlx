config {
  type: "table",
  schema: "reports",
  name: "revenue_by_region",
  tags: ["revenue_daily"]
}

-- Revenue by region
-- owner: olena.kravets@acme.co
-- created: 2022-05-02
SELECT
    payment_date AS report_date,
    region,
    * EXCEPT (payment_date, region)
FROM ${ref("revenue_daily")}
WHERE payment_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 400 DAY)
